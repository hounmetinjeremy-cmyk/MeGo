# dependencies
node_modules/

# Secrets

google-service-account*.json
google-service-account copy.json
# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files — .env itself is intentionally NOT ignored: Expo's CLI
# (`expo export`, unlike EAS Build) only auto-loads plain `.env`/`.env.local`,
# not `.env.production`, so committed public EXPO_PUBLIC_* values (never
# secrets — those go in .dev.vars or Cloudflare Worker secrets) live there.
.env*.local
.dev.vars
.wrangler/
# typescript
*.tsbuildinfo

app-example
