# Public Google OAuth Web client id (not a secret — safe to commit). Same
# value as the mobile app's own .env (EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID).
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=545417768480-4l1rmpk3iq7jcsga2bi8jk0o6d1uqq6p.apps.googleusercontent.com

# Enables the Multi Vendor / Single Vendor toggle from the original design
# (lib/ui/useable-components/vendor-mode-toggle). Without this, the toggle
# hides itself (see lib/mode/environment.ts isSingleVendorEnabled()).
NEXT_PUBLIC_SINGLE_VENDOR_ENABLED=true
